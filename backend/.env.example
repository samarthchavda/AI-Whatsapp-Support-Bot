# Server Configuration
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/whatsapp-support-bot

# AI Service Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Bot Configuration
HIGH_PRIORITY_KEYWORDS=urgent,critical,emergency,refund,complaint,angry

# Authentication
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Webhook Configuration
WEBHOOK_SECRET_TOKEN=your_secure_random_token_here
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here
WOOCOMMERCE_WEBHOOK_SECRET=your_woocommerce_webhook_secret_here

# Optional: OpenAI (if using GPT instead of Gemini)
# OPENAI_API_KEY=your_openai_api_key_here

# Email Configuration (for sending credentials)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Meta Developer App Configuration for Embedded Signup
META_APP_ID=2242808243238982
META_CLIENT_SECRET=your_meta_app_secret_here
META_CONFIG_ID=1066111046278122

# Optional Meta-cost fallback. Copy CURRENT values from Meta's official INR rate
# card before enabling; old or illustrative rates must not be shown as charges.
# META_INR_RATE_CARD_JSON={"effectiveDate":"YYYY-MM-DD","marketing":0,"utility":0,"authentication":0,"service":0}

# Auth token secrets (required; long random strings)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Signs short-lived links for private files such as invoice PDFs (falls back to JWT_ACCESS_SECRET)
FILE_SIGNING_SECRET=

# Razorpay (required for paid plans; can also be set in Super Admin > Settings). No fallback keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: password used by scripts/create*Admin.js (random one generated if unset)
SEED_ADMIN_PASSWORD=

# Meta webhook signature check: monitor (log only, default) | enforce (reject bad signatures) | off
META_WEBHOOK_SIGNATURE_MODE=monitor
# Optional: comma-separated app secrets of merchants who connected their own Meta app
META_WEBHOOK_EXTRA_APP_SECRETS=
